<UserControl x:Class="FModel.Views.Resources.Controls.LowLevelViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             DataContextChanged="OnDataContextChanged"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="TrimmedCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl x:Name="ViewModeTabs">
            <TabItem Header="Workspace">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0 0 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Class" />
                        <ComboBox x:Name="ClassSelector"
                                  Grid.Column="1"
                                  DisplayMemberPath="ClassName"
                                  SelectionChanged="OnClassSelectionChanged" />

                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Filter" />
                        <TextBox x:Name="FilterTextBox"
                                 Grid.Column="4"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />

                        <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="Go To" />
                        <TextBox x:Name="GoToOffsetTextBox"
                                 Grid.Column="7"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Offset in 0x... or decimal format" />

                        <ComboBox x:Name="OffsetModeComboBox"
                                  Grid.Column="9"
                                  SelectionChanged="OnOffsetModeChanged" />
                        <Button Grid.Column="10" Content="Back" Click="OnBackClicked" />
                        <Button Grid.Column="11" Content="Next" Click="OnForwardClicked" />
                        <Button Grid.Column="12" Content="Go" Click="OnGoToOffsetClicked" />

                        <TextBlock x:Name="HeaderStatusText"
                                   Grid.Column="13"
                                   Margin="12 0 0 0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static adonisUi:Brushes.AccentBrush}}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <TabControl x:Name="NavigatorTabs" Grid.Column="0">
                            <TabItem Header="Functions">
                                <DataGrid x:Name="FunctionsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          SelectionChanged="OnFunctionSelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Function" Binding="{Binding Name}" Width="2*" MinWidth="130" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding ScriptSize, StringFormat=0x{0:X}}" Width="*" MinWidth="80" />
                                        <DataGridTextColumn Header="Instr" Binding="{Binding InstructionCount}" Width="*" MinWidth="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Maps">
                                <TabControl>
                                    <TabItem Header="ExportMap">
                                        <DataGrid x:Name="ExportMapGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  MouseDoubleClick="OnExportMapDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="56" />
                                                <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="2*" />
                                                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*" />
                                                <DataGridTextColumn Header="Raw" Binding="{Binding RawOffsetDisplay}" Width="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="ImportMap">
                                        <DataGrid x:Name="ImportMapGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="56" />
                                                <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="*" />
                                                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*" />
                                                <DataGridTextColumn Header="Package" Binding="{Binding PackageName}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="NameMap">
                                        <DataGrid x:Name="NameMapGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  MouseDoubleClick="OnNameMapDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="56" />
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                                <DataGridTextColumn Header="Uses" Binding="{Binding UsageCount}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </TabItem>
                        </TabControl>

                        <GridSplitter Grid.Column="1"
                                      Width="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />

                        <TabControl x:Name="MainTabs" Grid.Column="2">
                            <TabItem Header="Disasm">
                                <DataGrid x:Name="InstructionsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          SelectionChanged="OnInstructionSelectionChanged"
                                          MouseDoubleClick="OnInstructionMouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Raw" Binding="{Binding RawOffsetDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Parser" Binding="{Binding ParserOffsetDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Script" Binding="{Binding ScriptOffsetDisplay}" Width="90" />
                                        <DataGridTextColumn Header="Block" Binding="{Binding BasicBlockId}" Width="65" />
                                        <DataGridTextColumn Header="Op" Binding="{Binding Opcode}" Width="150" />
                                        <DataGridTextColumn Header="Byte" Binding="{Binding OpcodeByte, StringFormat=0x{0:X2}}" Width="70" />
                                        <DataGridTextColumn Header="Cat" Binding="{Binding OpcodeCategory}" Width="120" />
                                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="110" />
                                        <DataGridTextColumn Header="Jump" Binding="{Binding JumpTargetLabel}" Width="110" />
                                        <DataGridTemplateColumn Header="Bytes" Width="210">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Bytes}" ToolTip="{Binding Bytes}" Style="{StaticResource TrimmedCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Decoded" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Decoded}" ToolTip="{Binding Decoded}" Style="{StaticResource TrimmedCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Operands">
                                <DataGrid x:Name="OperandsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          SelectionChanged="OnOperandSelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field" Binding="{Binding DisplayName}" Width="2*" />
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" />
                                        <DataGridTextColumn Header="Range" Binding="{Binding RangeDisplay}" Width="140" />
                                        <DataGridTextColumn Header="Asset Raw Range" Binding="{Binding AssetRawRangeDisplay}" Width="170" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding Length}" Width="60" />
                                        <DataGridTextColumn Header="Conf" Binding="{Binding Confidence}" Width="80" />
                                        <DataGridTemplateColumn Header="Bytes" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Bytes}" ToolTip="{Binding Bytes}" Style="{StaticResource TrimmedCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Value" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" Style="{StaticResource TrimmedCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Reason" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}" Style="{StaticResource TrimmedCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="CFG">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <DataGrid x:Name="CfgBlocksGrid"
                                              Grid.Column="0"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              SelectionChanged="OnCfgBlockSelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Block" Binding="{Binding Id}" Width="70" />
                                            <DataGridTextColumn Header="Script Range" Binding="{Binding ScriptRangeDisplay}" Width="140" />
                                            <DataGridTextColumn Header="First" Binding="{Binding FirstInstructionIndex}" Width="70" />
                                            <DataGridTextColumn Header="Last" Binding="{Binding LastInstructionIndex}" Width="70" />
                                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <GridSplitter Grid.Column="1"
                                                  Width="4"
                                                  HorizontalAlignment="Stretch"
                                                  Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />

                                    <DataGrid x:Name="CfgEdgesGrid"
                                              Grid.Column="2"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              SelectionChanged="OnCfgEdgeSelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="From" Binding="{Binding FromBlockId}" Width="70" />
                                            <DataGridTextColumn Header="To" Binding="{Binding ToBlockId}" Width="70" />
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="150" />
                                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Hex">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="AutoSyncCheckBox"
                                              Grid.Row="0"
                                              Margin="0 0 0 4"
                                              VerticalAlignment="Center"
                                              Content="Auto sync hex with selected instruction"
                                              IsChecked="{Binding LowLevelAutoSyncHex, Mode=TwoWay}"
                                              Checked="OnAutoSyncChanged"
                                              Unchecked="OnAutoSyncChanged" />
                                    <DataGrid x:Name="HexGrid"
                                              Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat=0x{0:X8}}" Width="120" />
                                            <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="240" />
                                            <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Property Tags">
                                <DataGrid x:Name="PropertyTagsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="80" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                                        <DataGridTemplateColumn Header="Value" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" Style="{StaticResource TrimmedCellText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Range" Binding="{Binding RangeDisplay}" Width="170" />
                                        <DataGridTextColumn Header="Value @" Binding="{Binding ValueOffsetDisplay}" Width="120" />
                                        <DataGridTemplateColumn Header="Fallback" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding ParserFallback, Mode=OneWay}"
                                                              IsHitTestVisible="False"
                                                              Focusable="False"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>

                        <GridSplitter Grid.Column="3"
                                      Width="4"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />

                        <GroupBox Grid.Column="4" Header="Inspector">
                            <TextBox x:Name="InspectorTextBox"
                                     Margin="6"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </GroupBox>
                    </Grid>

                    <GridSplitter Grid.Row="2"
                                  HorizontalAlignment="Stretch"
                                  Height="4"
                                  Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}" />

                    <TabControl Grid.Row="3">
                        <TabItem Header="Outgoing Xrefs">
                            <DataGrid x:Name="OutgoingXrefsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="OnOutgoingXrefSelectionChanged"
                                      MouseDoubleClick="OnOutgoingXrefDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                                    <DataGridTextColumn Header="From" Binding="{Binding SourceLocationDisplay}" Width="220" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplay}" Width="2*" />
                                    <DataGridTextColumn Header="Resolved" Binding="{Binding IsResolved}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Incoming Xrefs">
                            <DataGrid x:Name="IncomingXrefsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="OnIncomingXrefSelectionChanged"
                                      MouseDoubleClick="OnIncomingXrefDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="130" />
                                    <DataGridTextColumn Header="From" Binding="{Binding SourceLocationDisplay}" Width="220" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplay}" Width="2*" />
                                    <DataGridTextColumn Header="Resolved" Binding="{Binding IsResolved}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Text">
                <avalonEdit:TextEditor x:Name="RawEditor"
                                       FontFamily="Consolas"
                                       FontSize="{Binding FontSize}"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       Foreground="#DAE5F2"
                                       Background="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}"
                                       Document="{Binding Document}"
                                       SyntaxHighlighting="{Binding Highlighter}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
